<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Overspan" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:alertDialogTheme">@style/Theme.Overspan.Dialog</item>
    </style>

    <style name="Theme.Overspan.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
    </style>

    <style name="DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>

    <style name="Theme.Overspan.Display" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/stage</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:alertDialogTheme">@style/Theme.Overspan.Dialog</item>
    </style>

    <style name="Text">
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Text.Title">
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Heading">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.Muted">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
    <style name="Text.Label">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Button.Primary">
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:minHeight">@dimen/control_height_lg</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Button.Ghost">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <style name="Button.Danger">
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="Field">
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">@dimen/space_3</item>
        <item name="android:paddingEnd">@dimen/space_3</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_faint</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="ToolButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:padding">@dimen/space_3</item>
        <item name="android:background">@drawable/bg_tool</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/on_toolbar</item>
    </style>
</resources>

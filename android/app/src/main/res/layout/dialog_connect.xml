<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_5"
    android:paddingTop="@dimen/space_5"
    android:paddingEnd="@dimen/space_5"
    android:paddingBottom="@dimen/space_4">
    <TextView android:id="@+id/c_name" style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:accessibilityHeading="true" />
    <TextView android:id="@+id/c_status" style="@style/Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:accessibilityLiveRegion="polite" android:text="@string/checking" />

    <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_5" android:text="@string/mode_question" />
    <RadioGroup android:id="@+id/c_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:orientation="vertical">
        <RadioButton android:id="@+id/c_extend" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" android:text="@string/mode_extend" android:textSize="@dimen/text_md" android:buttonTint="@color/accent" android:checked="true" />
        <RadioButton android:id="@+id/c_mirror" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" android:text="@string/mode_mirror" android:textSize="@dimen/text_md" android:buttonTint="@color/accent" />
    </RadioGroup>
    <TextView android:id="@+id/c_mode_hint" style="@style/Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mode_extend_hint" />

    <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_5" android:labelFor="@+id/c_device" android:text="@string/device_name" />
    <EditText android:id="@+id/c_device" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:inputType="textCapSentences" android:maxLength="60" android:imeOptions="actionDone" android:importantForAutofill="no" />
    <TextView style="@style/Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:text="@string/device_name_hint" />

    <Button android:id="@+id/c_connect" style="@style/Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_5" android:text="@string/connect" />
    <Button android:id="@+id/c_forget" style="@style/Button.Ghost" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:text="@string/forget" android:visibility="gone" />
</LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_5"
    android:paddingTop="@dimen/space_3"
    android:paddingEnd="@dimen/space_5">
    <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:labelFor="@+id/a_addr" android:text="@string/address_label" />
    <EditText android:id="@+id/a_addr" style="@style/Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:fontFamily="monospace" android:hint="@string/address_hint" android:inputType="textUri" android:importantForAutofill="no" />
    <TextView android:id="@+id/a_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textColor="@color/danger" android:textSize="@dimen/text_sm" android:accessibilityLiveRegion="assertive" android:visibility="gone" android:text="@string/address_invalid" />
</LinearLayout>

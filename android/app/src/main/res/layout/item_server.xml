<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3"
    android:background="@drawable/bg_card"
    android:focusable="true"
    android:clickable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/control_height_lg"
    android:orientation="horizontal"
    android:padding="@dimen/space_4">
    <ImageView
        android:layout_width="@dimen/avatar"
        android:layout_height="@dimen/avatar"
        android:background="@drawable/bg_avatar"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_2"
        android:src="@drawable/ic_computer"
        android:tint="@color/accent" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/name" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textStyle="bold" />
        <TextView android:id="@+id/addr" style="@style/Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <TextView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:paddingStart="@dimen/space_2"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_1"
        android:textSize="@dimen/text_xs"
        android:textStyle="bold" />
</LinearLayout>
